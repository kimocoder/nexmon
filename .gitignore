# --- build output from a `make` run with the repo root as CWD -------------
# The per-chip patch Makefiles do `mkdir -p obj gen log` and create
# BUILD_NUMBER relative to the current directory, so invoking one from the
# repository root (rather than from patches/<chip>/<fwver>/nexmon) leaves
# these here. The real per-chip copies are covered by patches/.gitignore.
/gen/
/obj/
/log/
/BUILD_NUMBER

# --- python ---------------------------------------------------------------
*.so
__pycache__/
*.pyc

# --- downloaded host toolchains -------------------------------------------
# Unmodified upstream release tarballs and runtime libs (~1.1 GB).
# setup_env.sh supports buildtools/arm-gnu-toolchain-15.3.rel1-aarch64-arm-none-eabi
# on aarch64 hosts (or falls back to legacy GCC 5.4 with buildtools/armhf-compat-libs
# rebuilt per buildtools/MATH_LIBRARIES.md).
/buildtools/arm-gnu-toolchain-*/
/buildtools/armhf-compat-libs/

# --- rig, editor and agent working directories ----------------------------
# Local to this machine; none of it is part of the project.
/.UUID
/.claude/
/.agents/
/.codex/
/.local-notes/
/.mainline-shared-backup/
/output.txt/

# Agent planning/spec drafts. Local working material, never committed.
/docs/superpowers/

# --- validation-run evidence ----------------------------------------------
# Only the machine output is ignored. The scripts and REPORT.md under
# audits/<date>/ are real engineering work and are deliberately NOT ignored,
# so that they stay visible until they are committed or moved to tools/.
/audits/**/evidence/
/audits/**/*.pcap
/audits/**/*.stdout
/audits/**/*.stderr

# --- test and diagnostic artifacts ----------------------------------------
/firmware_backup/
/.ruff_cache/
/.pytest_cache/
/DISABLE_STATISTICS
/updates.json
utilities/rawproxy/fuzz_radiotap_sanitize
utilities/libnexio/libnexio_sanitize.*
utilities/nexutil/nexutil
utilities/dhdutil/dhdutil
*.ko
*.mod*
Module.symvers
